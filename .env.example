# Weladee Form Environment Variables Example
# Copy this file to .env.local and modify the values for your environment

# ==============================================
# Required Configuration
# ==============================================

# PostgreSQL Database URL (Required)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/weladee_form

# ==============================================
# Optional Configuration
# ==============================================

# gRPC Server Port (default: 50051)
GRPC_PORT=50051

# JWT Secret for token validation
# Change this in production!
JWT_SECRET=your-jwt-secret-here
# Asymmetric Keys (RS256) - Optional but recommended for security
# JWT_PRIVATE_KEY_PATH=./private_key.pem
# JWT_PUBLIC_KEY_PATH=./public_key.pem

# ----------------------------------------------
# reCAPTCHA v3 Configuration (Optional)
# ----------------------------------------------
# Google reCAPTCHA v3 for bot protection on forms
# Get keys from: https://www.google.com/recaptcha/admin
#
# Enable/disable reCAPTCHA globally
RECAPTCHA_ENABLED=false
# Site key (used in frontend - can be exposed)
RECAPTCHA_SITE_KEY=your-site-key-here
# Secret key (used in backend - keep secret!)
RECAPTCHA_SECRET_KEY=your-secret-key-here
# Score threshold (0.0-1.0, default 0.5)
# Lower = stricter, Higher = more lenient
RECAPTCHA_THRESHOLD=0.5

# ----------------------------------------------
# S3 Storage Configuration (Optional)
# ----------------------------------------------
# Required for file upload question type
# Supports AWS S3, Cloudflare R2, MinIO, and other S3-compatible storage
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=https://your-s3-endpoint.com

# ----------------------------------------------
# Frontend API URLs (Optional)
# ----------------------------------------------
# Only set these if you want to use an external API server
# For embedded builds (default), these are not needed as the frontend
# connects to the same origin that serves it
#
# NEXT_PUBLIC_GRPC_URL=http://localhost:50051
# NEXT_PUBLIC_API_URL=http://localhost:50051
